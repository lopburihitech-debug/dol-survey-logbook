# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าก่อนใช้งานจริง
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ฐานข้อมูล ---
# ปล่อยว่างไว้ (ค่าเริ่มต้น) เพื่อใช้ SQLite ไฟล์เดียวในเครื่อง:
DATABASE_PATH=./data/dol_survey_logbook.db

# ถ้าต้องการต่อฐานข้อมูล PostgreSQL ออนไลน์แทน (เช่นจาก Railway/Render/Supabase/Neon) ให้ตั้งค่าตัวแปรนี้แทน
# — เมื่อมีค่านี้ ระบบจะใช้ PostgreSQL โดยอัตโนมัติและไม่สนใจ DATABASE_PATH ด้านบน (ดู DEPLOY.md หัวข้อ "ต่อฐานข้อมูลออนไลน์")
# DATABASE_URL=postgres://user:password@host:5432/dbname
